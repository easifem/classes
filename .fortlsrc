  "pp_defs": {
  "DEBUG_VER": "",
  "DEBUG_VER": "",
  "USE_CMAKE": "",
  "USE_Real64": "",
  "USE_Int32": "",
  "USE_GMSH": "",
  "USE_LUA": "",
  "USE_LIS": "",
  "USE_SUPERLU": ""
  },
  "excl_paths": ["docs/**", "build/**", "src/modules/*/examples/**"]
}
